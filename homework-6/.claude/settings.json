{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-coverage.sh",
            "timeout": 120,
            "statusMessage": "Checking test coverage gate before push..."
          }
        ]
      }
    ]
  }
}
